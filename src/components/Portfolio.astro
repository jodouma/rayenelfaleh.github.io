---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import NetworkBackground from './NetworkBackground.astro';
import { content, profile, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cvHref = `${base}${profile.cv}`;
const navItems = [
  ['about', t.nav.about],
  ['skills', t.nav.skills],
  ['projects', t.nav.projects],
  ['experience', t.nav.experience],
  ['contact', t.nav.contact],
] as const;
const year = new Date().getFullYear();
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <div class="grid-bg" aria-hidden="true"></div>
  <NetworkBackground />

  <header class="topbar">
    <div class="container topbar-inner">
      <a href={lang === 'en' ? base : `${base}fr/`} class="brand" aria-label={profile.name}>
        <span class="brand-mark">&gt;_</span>
        <span>rayen<span class="accent">.faleh</span></span>
      </a>
      <nav class="nav" aria-label="Sections">
        {navItems.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
      <div class="topbar-actions">
        <a class="pill-btn" href={`${base}${t.switchHref}`} hreflang={lang === 'fr' ? 'en' : 'fr'}>{t.switchLabel}</a>
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle theme">
          <span class="sun"><Icon name="sun" /></span>
          <span class="moon"><Icon name="moon" /></span>
        </button>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="hero container">
      <div class="hero-copy reveal">
        <p class="status"><span class="dot"></span>{t.hero.status}</p>
        <h1>{profile.name}</h1>
        <p class="role mono">{t.hero.role}</p>
        <p class="tagline">{t.hero.tagline}</p>
        <div class="cta">
          <a class="btn primary" href="#contact"><Icon name="mail" />{t.hero.ctaContact}</a>
          <a class="btn ghost" href={cvHref} download><Icon name="download" />{t.hero.ctaCv}</a>
        </div>
        <div class="socials">
          <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" /></a>
          <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a>
          <a href={`mailto:${profile.email}`} aria-label="Email"><Icon name="mail" /></a>
        </div>
      </div>

      <div class="terminal reveal" aria-hidden="true">
        <div class="term-bar">
          <span></span><span></span><span></span>
          <p>kali@lab: ~</p>
        </div>
        <pre class="term-body" id="term"><code></code></pre>
      </div>
    </section>

    <section class="container stats reveal">
      {t.hero.stats.map((s) => (
        <div class="stat">
          <span class="stat-value mono">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </section>

    <!-- About -->
    <section id="about" class="section container">
      <h2 class="section-title reveal"><span class="mono accent">01.</span> {t.about.title}</h2>
      <div class="about reveal">
        <div class="about-body">
          {t.about.body.map((p) => <p>{p}</p>)}
        </div>
        <dl class="facts">
          {t.about.facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="section container">
      <h2 class="section-title reveal"><span class="mono accent">02.</span> {t.skills.title}</h2>
      <div class="skills">
        {t.skills.groups.map((g) => (
          <article class="card reveal">
            <div class="card-head">
              <span class="card-icon"><Icon name={g.icon} /></span>
              <h3>{g.name}</h3>
            </div>
            <ul class="chips">
              {g.items.map((i) => <li>{i}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="section container">
      <h2 class="section-title reveal"><span class="mono accent">03.</span> {t.projects.title}</h2>
      <div class="projects">
        {t.projects.items.map((p) => (
          <article class:list={['card', 'project', 'reveal', { featured: p.featured }]}>
            <div class="project-meta mono">
              <span>{p.kind}</span>
              <span>{p.year}</span>
            </div>
            <h3>{p.title}</h3>
            <ul class="points">
              {p.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <ul class="tags mono">
              {p.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            {p.link && (
              <a class="project-link" href={p.link} target="_blank" rel="noopener">
                {p.linkLabel} <Icon name="arrow" />
              </a>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- Experience & education -->
    <section id="experience" class="section container">
      <h2 class="section-title reveal"><span class="mono accent">04.</span> {t.experience.title}</h2>
      <div class="background">
        <div>
          <h3 class="sub-title mono reveal">{t.experience.workTitle}</h3>
          <ol class="timeline">
            {t.experience.work.map((w) => (
              <li class="reveal">
                <div class="tl-head">
                  <h4>{w.role}</h4>
                  <span class="mono period">{w.period}</span>
                </div>
                <p class="org">{w.org}</p>
                <ul class="points">
                  {w.points.map((pt) => <li>{pt}</li>)}
                </ul>
              </li>
            ))}
          </ol>
        </div>
        <div class="side">
          <h3 class="sub-title mono reveal">{t.experience.eduTitle}</h3>
          <ol class="timeline">
            {t.experience.education.map((e) => (
              <li class="reveal">
                <div class="tl-head">
                  <h4>{e.degree}</h4>
                </div>
                <p class="org">{e.school}</p>
                <p class="mono period">
                  {e.period}
                  {e.note && <span class="badge">{e.note}</span>}
                </p>
              </li>
            ))}
          </ol>

          <h3 class="sub-title mono reveal">{t.experience.languagesTitle}</h3>
          <ul class="langs reveal">
            {t.experience.languages.map((l) => (
              <li>
                <div class="lang-row">
                  <span>{l.name}</span>
                  <span class="lang-level">{l.level}</span>
                </div>
                <div class="bar"><span style={`--w:${l.pct}%`}></span></div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="section container">
      <div class="contact card reveal">
        <p class="mono accent">05. {t.nav.contact}</p>
        <h2>{t.contact.title}</h2>
        <p>{t.contact.body}</p>
        <div class="cta center">
          <a class="btn primary" href={`mailto:${profile.email}`}><Icon name="mail" />{t.contact.email}</a>
          <a class="btn ghost" href={profile.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a>
          <a class="btn ghost" href={profile.github} target="_blank" rel="noopener"><Icon name="github" />GitHub</a>
        </div>
        <p class="mono contact-mail">{profile.email} · {profile.location}</p>
      </div>
    </section>
  </main>

  <footer class="footer container mono">
    <span>© {year} {profile.name}</span>
    <span>{t.footer}</span>
  </footer>

  <script define:vars={{ lang }}>
    // Terminal typing animation
    const lines =
      lang === 'fr'
        ? [
            ['$ ', 'whoami'],
            ['', 'rayen — master cybersécurité, red & blue team'],
            ['$ ', 'nmap -sV -p445 10.10.10.40'],
            ['', '445/tcp open  microsoft-ds  Windows 7 SP1'],
            ['$ ', 'msf6 > use exploit/windows/smb/ms17_010_eternalblue'],
            ['', '[+] Meterpreter session 1 opened'],
            ['$ ', 'wazuh-alert --rule sysmon --mitre T1210'],
            ['', '[!] Lateral movement détecté → rapport généré'],
            ['$ ', 'cat disponibilite.txt'],
            ['', 'Stage PFE · 6 mois · février 2027'],
          ]
        : [
            ['$ ', 'whoami'],
            ['', 'rayen — cybersecurity master’s, red & blue team'],
            ['$ ', 'nmap -sV -p445 10.10.10.40'],
            ['', '445/tcp open  microsoft-ds  Windows 7 SP1'],
            ['$ ', 'msf6 > use exploit/windows/smb/ms17_010_eternalblue'],
            ['', '[+] Meterpreter session 1 opened'],
            ['$ ', 'wazuh-alert --rule sysmon --mitre T1210'],
            ['', '[!] Lateral movement detected → report generated'],
            ['$ ', 'cat availability.txt'],
            ['', 'Internship · 6 months · February 2027'],
          ];

    const el = document.querySelector('#term code');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
    const render = (done, partial) =>
      done
        .map(([p, txt]) => (p ? `<span class="prompt">${p}</span>${esc(txt)}` : `<span class="out">${esc(txt)}</span>`))
        .join('\n') + (partial ?? '') + '<span class="caret"></span>';

    if (reduce) {
      el.innerHTML = render(lines);
    } else {
      let i = 0;
      const done = [];
      const next = () => {
        if (i >= lines.length) {
          el.innerHTML = render(done);
          return;
        }
        const [p, txt] = lines[i];
        const sep = done.length ? '\n' : '';
        if (!p) {
          done.push(lines[i++]);
          el.innerHTML = render(done);
          setTimeout(next, 380);
          return;
        }
        let c = 0;
        const type = () => {
          c++;
          el.innerHTML = render(done, `${sep}<span class="prompt">${p}</span>${esc(txt.slice(0, c))}`);
          if (c < txt.length) setTimeout(type, 28 + Math.random() * 40);
          else {
            done.push(lines[i++]);
            setTimeout(next, 260);
          }
        };
        type();
      };
      setTimeout(next, 500);
    }

    // Reveal on scroll
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.12 },
    );
    document.querySelectorAll('.reveal').forEach((n) => io.observe(n));

    // Theme toggle
    document.getElementById('theme-toggle').addEventListener('click', () => {
      const root = document.documentElement;
      const current =
        root.dataset.theme || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      const nextTheme = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = nextTheme;
      try {
        localStorage.setItem('theme', nextTheme);
      } catch {}
    });
  </script>
</Base>
