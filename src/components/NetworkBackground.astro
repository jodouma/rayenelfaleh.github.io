---
// Interactive "live network" background.
// - Three depth layers of hosts with mouse and scroll parallax.
// - Data packets travel slowly along the links like network traffic.
// - The cursor is a scanner: a rotating reticle that locks onto the nearest host,
//   lights up hosts around it and shows the host's address.
// - Clicking sends a radar sweep that lights up every host it passes.
---

<canvas id="net-bg" aria-hidden="true"></canvas>
<div class="cursor-glow" aria-hidden="true"></div>

<script is:inline>
  (() => {
    const canvas = document.getElementById('net-bg');
    const glow = document.querySelector('.cursor-glow');
    const ctx = canvas.getContext('2d');
    // With reduced motion, hosts don't drift and no idle traffic plays; the cursor still interacts.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const LINK = 140; // max distance for host-host links
    const REACH = 220; // scanner radius
    const TAU = Math.PI * 2;

    let w = 0, h = 0, dpr = 1, raf = 0, t = 0;
    let nodes = [], packets = [], pings = [];
    let rgbA = '62,230,168', rgbB = '76,201,240';
    let sprite = null; // pre-rendered glow dot, much cheaper than shadowBlur
    const mouse = { x: -9999, y: -9999, sx: -9999, sy: -9999, qx: -9999, qy: -9999, active: false, seen: false };
    let lock = null, lockFade = 0;

    const hex = (c) => {
      const m = c.trim().match(/^#?([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i);
      return m ? m.slice(1).map((x) => parseInt(x, 16)).join(',') : null;
    };
    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      rgbA = hex(s.getPropertyValue('--accent')) || rgbA;
      rgbB = hex(s.getPropertyValue('--accent-2')) || rgbB;
      sprite = document.createElement('canvas');
      sprite.width = sprite.height = 64;
      const g = sprite.getContext('2d');
      const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
      grad.addColorStop(0, `rgba(${rgbA},1)`);
      grad.addColorStop(0.25, `rgba(${rgbA},0.45)`);
      grad.addColorStop(1, `rgba(${rgbA},0)`);
      g.fillStyle = grad;
      g.fillRect(0, 0, 64, 64);
    };

    const randIp = () => `10.${(Math.random() * 20) | 0}.${(Math.random() * 255) | 0}.${((Math.random() * 253) | 0) + 1}`;

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round(Math.min(140, Math.max(40, (w * h) / 10500)));
      const speed = reduce ? 0 : 0.12;
      nodes = Array.from({ length: count }, () => {
        const z = [0.35, 0.65, 1][(Math.random() * 3) | 0]; // depth layer
        return {
          x: Math.random() * w,
          y: Math.random() * h,
          z,
          vx: (Math.random() - 0.5) * speed * z,
          vy: (Math.random() - 0.5) * speed * z,
          r: (Math.random() * 0.8 + 0.8) * (0.6 + z * 0.7),
          lit: 0,
          ip: randIp(),
          px: 0,
          py: 0,
          tw: Math.random() * TAU, // twinkle phase
        };
      });
      packets = [];
    };

    // screen position with mouse + scroll parallax; deeper layers move less
    const project = (n) => {
      const mx = mouse.seen ? (mouse.qx - w / 2) / w : 0;
      const my = mouse.seen ? (mouse.qy - h / 2) / h : 0;
      const sy = window.scrollY * 0.12 * n.z;
      n.px = n.x - mx * 16 * n.z;
      let y = n.y - my * 16 * n.z - sy;
      const span = h + 60;
      n.py = ((((y + 30) % span) + span) % span) - 30;
    };

    const spawnPacket = (from) => {
      const a = from || nodes[(Math.random() * nodes.length) | 0];
      let best = null, bd = LINK * LINK;
      for (let k = 0; k < 6; k++) {
        const b = nodes[(Math.random() * nodes.length) | 0];
        if (b === a) continue;
        const dx = a.px - b.px, dy = a.py - b.py, d2 = dx * dx + dy * dy;
        if (d2 < bd) { bd = d2; best = b; }
      }
      if (!best) {
        // fall back to scanning for any neighbour
        for (const b of nodes) {
          if (b === a) continue;
          const dx = a.px - b.px, dy = a.py - b.py, d2 = dx * dx + dy * dy;
          if (d2 < bd) { bd = d2; best = b; }
        }
      }
      if (best) packets.push({ a, b: best, p: 0, v: 0.005 + Math.random() * 0.007, hue: Math.random() < 0.3 ? 1 : 0 });
    };

    const step = () => {
      t += 1;
      // smooth the cursor so everything that follows it eases
      if (mouse.seen) {
        mouse.sx += (mouse.x - mouse.sx) * 0.06;
        mouse.sy += (mouse.y - mouse.sy) * 0.06;
        // parallax follows the cursor much more lazily so the field glides instead of jumping
        mouse.qx += (mouse.x - mouse.qx) * 0.02;
        mouse.qy += (mouse.y - mouse.qy) * 0.02;
      }
      for (const n of nodes) {
        if (!reduce) {
          n.x += n.vx;
          n.y += n.vy;
          if (n.x < -30) n.x = w + 30; else if (n.x > w + 30) n.x = -30;
          if (n.y < -30) n.y = h + 30; else if (n.y > h + 30) n.y = -30;
        }
        project(n);
        if (mouse.active) {
          const d = Math.hypot(mouse.sx - n.px, mouse.sy - n.py);
          if (d < REACH) {
            // fade hosts in gradually instead of snapping to full brightness
            const target = (1 - d / REACH) * 0.9;
            if (target > n.lit) n.lit += (target - n.lit) * 0.05;
          }
        }
        for (const p of pings) {
          const d = Math.hypot(p.x - n.px, p.y - n.py);
          if (Math.abs(d - p.r) < 14) {
            if (n.lit < 0.5 && Math.random() < 0.35) spawnPacket(n);
            n.lit = 1;
          }
        }
        n.lit *= 0.98;
      }
      for (const p of pings) { p.r += 4; p.life = 1 - p.r / p.max; }
      pings = pings.filter((p) => p.life > 0);

      // traffic: the same gentle trickle whether or not the cursor is on the page
      if (!reduce && packets.length < 40 && Math.random() < 0.08) spawnPacket();
      for (const k of packets) k.p += k.v;
      packets = packets.filter((k) => k.p < 1 && Math.hypot(k.a.px - k.b.px, k.a.py - k.b.py) < LINK * 1.5);

      // scanner lock: nearest host within reach
      let best = null, bd = REACH * 0.6;
      if (mouse.active) {
        for (const n of nodes) {
          if (n.z < 0.6) continue;
          const d = Math.hypot(mouse.sx - n.px, mouse.sy - n.py);
          if (d < bd) { bd = d; best = n; }
        }
      }
      // keep the current lock unless another host is clearly closer, so it doesn't flicker
      if (lock && best && best !== lock) {
        const dl = Math.hypot(mouse.sx - lock.px, mouse.sy - lock.py);
        if (dl < REACH * 0.6 && bd > dl * 0.6) best = lock;
      }
      if (best !== lock) { if (best) { lock = best; lockFade = 0; } else lockFade -= 0.05; }
      else if (lock) lockFade = Math.min(1, lockFade + 0.05);
      if (lockFade < 0 && !best) lock = null;
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);

      // links
      ctx.lineWidth = 1;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          if (Math.abs(a.z - b.z) > 0.31) continue; // link within / adjacent layers only
          const dx = a.px - b.px, dy = a.py - b.py;
          const d2 = dx * dx + dy * dy;
          if (d2 > LINK * LINK) continue;
          const k = 1 - Math.sqrt(d2) / LINK;
          const lit = Math.max(a.lit, b.lit);
          const o = k * (0.08 + 0.14 * (a.z + b.z) * 0.5 + lit * 0.5);
          ctx.strokeStyle = `rgba(${rgbA},${o})`;
          ctx.beginPath();
          ctx.moveTo(a.px, a.py);
          ctx.lineTo(b.px, b.py);
          ctx.stroke();
        }
      }

      // scanner beams to the closest lit hosts
      if (mouse.active) {
        const near = nodes
          .filter((n) => n.lit > 0.25 && n.z > 0.5)
          .sort((p, q) => q.lit - p.lit)
          .slice(0, 7);
        for (const n of near) {
          const g = ctx.createLinearGradient(mouse.sx, mouse.sy, n.px, n.py);
          g.addColorStop(0, `rgba(${rgbA},0)`);
          g.addColorStop(1, `rgba(${rgbA},${n.lit * 0.7})`);
          ctx.strokeStyle = g;
          ctx.lineWidth = 1.2;
          ctx.beginPath();
          ctx.moveTo(mouse.sx, mouse.sy);
          ctx.lineTo(n.px, n.py);
          ctx.stroke();
        }
      }

      // hosts
      for (const n of nodes) {
        const tw = reduce ? 1 : 0.8 + 0.2 * Math.sin(t * 0.015 + n.tw);
        const a = (0.25 + 0.5 * n.z) * tw + n.lit * 0.6;
        ctx.fillStyle = `rgba(${rgbA},${Math.min(1, a)})`;
        ctx.beginPath();
        ctx.arc(n.px, n.py, n.r + n.lit * 1.6, 0, TAU);
        ctx.fill();
        if (n.lit > 0.15) {
          const s = 18 + n.lit * 22;
          ctx.globalAlpha = n.lit * 0.9;
          ctx.drawImage(sprite, n.px - s / 2, n.py - s / 2, s, s);
          ctx.globalAlpha = 1;
        }
      }

      // packets with short trails
      for (const k of packets) {
        const e = k.p < 0.5 ? 2 * k.p * k.p : 1 - Math.pow(-2 * k.p + 2, 2) / 2; // ease in-out
        const x = k.a.px + (k.b.px - k.a.px) * e;
        const y = k.a.py + (k.b.py - k.a.py) * e;
        const e2 = Math.max(0, e - 0.12);
        const tx = k.a.px + (k.b.px - k.a.px) * e2;
        const ty = k.a.py + (k.b.py - k.a.py) * e2;
        const rgb = k.hue ? rgbB : rgbA;
        const g = ctx.createLinearGradient(tx, ty, x, y);
        g.addColorStop(0, `rgba(${rgb},0)`);
        g.addColorStop(1, `rgba(${rgb},0.9)`);
        ctx.strokeStyle = g;
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        ctx.moveTo(tx, ty);
        ctx.lineTo(x, y);
        ctx.stroke();
        ctx.fillStyle = `rgba(${rgb},1)`;
        ctx.beginPath();
        ctx.arc(x, y, 1.6, 0, TAU);
        ctx.fill();
        ctx.globalAlpha = 0.7;
        ctx.drawImage(sprite, x - 9, y - 9, 18, 18);
        ctx.globalAlpha = 1;
      }

      // radar sweeps
      for (const p of pings) {
        ctx.lineWidth = 2;
        ctx.strokeStyle = `rgba(${rgbA},${p.life * 0.7})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, TAU);
        ctx.stroke();
        ctx.lineWidth = 1;
        ctx.strokeStyle = `rgba(${rgbA},${p.life * 0.25})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r * 0.82, 0, TAU);
        ctx.stroke();
      }

      // cursor reticle: rotating brackets
      if (mouse.active) {
        const rot = reduce ? 0 : t * 0.008;
        ctx.strokeStyle = `rgba(${rgbA},0.85)`;
        ctx.lineWidth = 1.5;
        for (let q = 0; q < 4; q++) {
          const a0 = rot + q * (TAU / 4);
          ctx.beginPath();
          ctx.arc(mouse.sx, mouse.sy, 14, a0, a0 + 0.7);
          ctx.stroke();
        }
        ctx.fillStyle = `rgba(${rgbA},0.9)`;
        ctx.beginPath();
        ctx.arc(mouse.sx, mouse.sy, 1.6, 0, TAU);
        ctx.fill();
      }

      // lock-on: corner box + address label on the nearest host
      if (lock && lockFade > 0) {
        const f = Math.max(0, lockFade);
        const s = 10 + (1 - f) * 10; // box closes in as it locks
        const c = 5;
        ctx.strokeStyle = `rgba(${rgbA},${f})`;
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        for (const [sx, sy] of [[-1, -1], [1, -1], [1, 1], [-1, 1]]) {
          const x = lock.px + sx * s, y = lock.py + sy * s;
          ctx.moveTo(x, y - sy * c);
          ctx.lineTo(x, y);
          ctx.lineTo(x - sx * c, y);
        }
        ctx.stroke();
        ctx.font = '500 11px "JetBrains Mono", ui-monospace, monospace';
        ctx.fillStyle = `rgba(${rgbA},${f * 0.95})`;
        ctx.fillText(lock.ip, lock.px + s + 8, lock.py - 4);
        ctx.fillStyle = `rgba(${rgbB},${f * 0.75})`;
        ctx.fillText('host up', lock.px + s + 8, lock.py + 10);
      }
    };

    const loop = () => {
      step();
      draw();
      raf = requestAnimationFrame(loop);
    };

    const onMove = (e) => {
      if (e.pointerType === 'touch' && e.type === 'pointermove') return; // let touch scroll freely
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      if (!mouse.seen) { mouse.sx = mouse.qx = e.clientX; mouse.sy = mouse.qy = e.clientY; mouse.seen = true; }
      mouse.active = true;
      glow.style.setProperty('--mx', `${e.clientX}px`);
      glow.style.setProperty('--my', `${e.clientY}px`);
      glow.classList.add('on');
    };
    const onDown = (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      if (!mouse.seen) { mouse.sx = mouse.qx = e.clientX; mouse.sy = mouse.qy = e.clientY; mouse.seen = true; }
      if (e.pointerType !== 'touch') mouse.active = true;
      pings.push({ x: e.clientX, y: e.clientY, r: 0, life: 1, max: Math.hypot(w, h) * 0.6 });
    };
    const onLeave = () => {
      mouse.active = false;
      glow.classList.remove('on');
    };

    readColors();
    resize();
    window.addEventListener('resize', resize);
    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('pointerdown', onDown, { passive: true });
    document.documentElement.addEventListener('pointerleave', onLeave);
    window.addEventListener('blur', onLeave);
    // re-read colors when the theme changes
    new MutationObserver(readColors).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', readColors);

    loop();
    // pause when the tab is hidden
    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) loop();
    });
  })();
</script>
